/**
 * -----------------------------------------------------------------------------
 * @brief	Processes Analog Inputs
 * -----------------------------------------------------------------------------
 */
void SX100_AnalogInputs(void)
{
	uint8_t msb;
	uint8_t lsb;

	// Configure SPI communication for ADC
	ADS8688A_SpiInit(0);

	// Perform analog inputs configuration
	adcConfigureInputs();

	// Receive CH0 data - Send CH2 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH2);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[2] = (uint16_t) (msb << 8U);
	isenRaw[2] |= (uint16_t) lsb;
	ADS8688A_Disable();
	SYSTEM_DelayUs(ADC_DELAY_US);

	// Receive CH2 data - Send CH3 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH3);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	ainRaw[0] = (uint16_t) (msb << 8U);
	ainRaw[0] |= (uint16_t) lsb;
	ADS8688A_Disable();
	SYSTEM_DelayUs(ADC_DELAY_US);

	// Receive CH3 data - Send CH4 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH4);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	ainRaw[1] = (uint16_t) (msb << 8U);
	ainRaw[1] |= (uint16_t) lsb;
	ADS8688A_Disable();
	SYSTEM_DelayUs(ADC_DELAY_US);

	// Receive CH4 data - Send CH5 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH5);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[1] = (uint16_t) (msb << 8U);
	isenRaw[1] |= (uint16_t) lsb;
	ADS8688A_Disable();
	SYSTEM_DelayUs(ADC_DELAY_US);

	// Receive CH5 data - Send CH7 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH7);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[0] = (uint16_t) (msb << 8U);
	isenRaw[0] |= (uint16_t) lsb;
	ADS8688A_Disable();
	SYSTEM_DelayUs(ADC_DELAY_US);

	// Receive CH7 data - Send CH0 request
	// ------------------------------------------------------------------------
	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH0);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[3] = (uint16_t) (msb << 8U);
	isenRaw[3] |= (uint16_t) lsb;
	ADS8688A_Disable();

}

/**
 * -----------------------------------------------------------------------------
 * @brief	Turning power supplies on/off
 * -----------------------------------------------------------------------------
 */
void SX100_PowerSupplies(void)
{
	// External power supply (5V)
	if (SX100.PowerSupply.Sensor5V)
		GPIO_Write(SYSTEM_EXT_SENSOR_PWR_GPIO, SYSTEM_EXT_SENSOR_PWR_PIN, 1);
	else
		GPIO_Write(SYSTEM_EXT_SENSOR_PWR_GPIO, SYSTEM_EXT_SENSOR_PWR_PIN, 0);

	// Internal power supply (NPN sensors)
	if (SX100.PowerSupply.DinNpn)
		GPIO_Write(SYSTEM_NPN_PWR_GPIO, SYSTEM_NPN_PWR_PIN, 1);
	else
		GPIO_Write(SYSTEM_NPN_PWR_GPIO, SYSTEM_NPN_PWR_PIN, 0);
}

/**
 * -----------------------------------------------------------------------------
 * @brief	Power monitor status update
 * -----------------------------------------------------------------------------
 */
void SX100_INA239_Update(void)
{
	static uint16_t aCurrent[PWRMON_AVG_SAMPLES];
	static uint16_t aVbus[PWRMON_AVG_SAMPLES];
	static uint8_t pwrmonInterval = 0;

	// Configure SPI communications
	if (INA239_SetupComm())
		return;

	// Enable INA239
	GPIO_Write(INA239_CS_GPIO, INA239_CS_PIN, 0);

	// Establish the interval at which voltage and current readings are taken
	if (pwrmonInterval < PWRMON_AVG_INTERVAL)
		pwrmonInterval++;
	else
	{
		pwrmonAddSample(aVbus, INA239_VBus());
		pwrmonAddSample(aCurrent, INA239_VShunt());
		pwrmonInterval = 0;
	}

	// Read bus voltage
	SX100.Status.VBus = pwrmonDoAverage(aVbus);

	// Read shunt current
	SX100.Status.Current = (uint16_t) ((pwrmonDoAverage(aCurrent) * 27) / 100);

	// Read die temperature
	SX100.Status.Temp = INA239_Temperature();

	// Calculate the system's power consumption (Watt x 100)
	SX100.Status.Power = (uint16_t) ((SX100.Status.VBus * SX100.Status.Current) / 10000);

	// Disable INA239
	GPIO_Write(INA239_CS_GPIO, INA239_CS_PIN, 1);
}

/**
 * -----------------------------------------------------------------------------
 * @brief			Add a sample to the power monitor array
 * -----------------------------------------------------------------------------
 * @param array		Array containing samples of the power monitor readings
 * @param sample	Sample to add
 * -----------------------------------------------------------------------------
 */
void pwrmonAddSample(uint16_t array[], uint16_t sample)
{
	for (uint8_t i = 0; i < PWRMON_AVG_SAMPLES - 1; i++)
		array[i] = array[i + 1];

	array[PWRMON_AVG_SAMPLES - 1] = sample;
}

/**
 * -----------------------------------------------------------------------------
 * @brief			Calculate the average of the values ​​contained in the array
 * -----------------------------------------------------------------------------
 * @param array		Array containing samples of the power monitor readings
 * @return			Result of the average calculation
 * -----------------------------------------------------------------------------
 */
uint16_t pwrmonDoAverage(uint16_t array[])
{
	uint32_t sum = 0;

	for (uint8_t i = 0; i < PWRMON_AVG_SAMPLES; i++)
		sum += array[i];

	return (uint16_t) (sum / PWRMON_AVG_SAMPLES);
}

/**
 * -----------------------------------------------------------------------------
 * @brief
 * -----------------------------------------------------------------------------
 */
void adcConfigureInputs(void)
{
	// AIN0 Enable 20mA current loop
	if (SX100.Ain[0].Enable20mA)
		GPIO_Write(SYSTEM_CREN_AIN0_GPIO, SYSTEM_CREN_AIN0_PIN, true);
	else
		GPIO_Write(SYSTEM_CREN_AIN0_GPIO, SYSTEM_CREN_AIN0_PIN, false);

	// AIN1 Enable 20mA current loop
	if (SX100.Ain[1].Enable20mA)
		GPIO_Write(SYSTEM_CREN_AIN1_GPIO, SYSTEM_CREN_AIN1_PIN, true);
	else
		GPIO_Write(SYSTEM_CREN_AIN1_GPIO, SYSTEM_CREN_AIN1_PIN, false);
}
