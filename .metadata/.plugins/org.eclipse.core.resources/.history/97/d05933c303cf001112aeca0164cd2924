// Definitions
// ----------------------------------------------------------------------------

// Global variables
// ----------------------------------------------------------------------------
const unsigned char SX100_128x64[];
CAN_Msg_t gCanMsgRx;
bool adcWrite = false;
bool adcRead = false;
uint8_t regAddr = 0x05;			// ADC Channel 1
uint8_t adcCmd = 0x05;			// Range 10.24V
uint8_t value;
uint16_t isenRaw[4];
uint16_t ainRaw[2];
uint8_t msb;
uint8_t lsb;
uint8_t delayUs = 5;

// Private methods
// ----------------------------------------------------------------------------
void UI_Update(void);
void COMM_Update(void);
void ADC_Update(void);

int main()
{
	// -------------------------------------------------------------------------
	// System Initialization
	// -------------------------------------------------------------------------
	SYSTEM_Init();
	SX100_Init();
	LCD_Init();
	LCD_Clear();

	// SX100 Screen
	Indicator.Backlight.Blue = LED_ON;
	Indicator.Backlight.Green = LED_ON;
	GLCD_ScreenBitmap(SX100_128x64);

	// CAN Allow all messages
	CAN_FilterAllowAll(CAN_FIFO0);
	CAN_FilterAllowAll(CAN_FIFO1);

	// Enable NPN power supply
	SX100.PowerSupply.InternalNpn = true;

	// Configure
	ADS8688A_Init();

	// -------------------------------------------------------------------------
	// Task Scheduler Section
	// -------------------------------------------------------------------------
	SCHEDULER_Init();
	SCHEDULER_AddTask(PWRBOARD_Update, 0, 10);
	SCHEDULER_AddTask(LCD_Update, 1, 10);
	SCHEDULER_AddTask(COMM_Update, 2, 50);
	SCHEDULER_AddTask(UI_Update, 4, 200);
	SCHEDULER_AddTask(ADC_Update, 5, 500);
	SCHEDULER_Start();

	while (1)
	{
		SCHEDULER_DispatchTasks();
	}
}

/**
 * -----------------------------------------------------------------------------
 * @brief	Test ADC
 * -----------------------------------------------------------------------------
 */
void ADC_Update(void)
{
	DEBUG_TimerStart();

	// Configure SPI communication for ADC
	ADS8688A_SpiInit(0);

	if (adcWrite)
	{
		adcWrite = false;

		// Perform write operation
		value = ADS8688A_WriteRegister(regAddr, adcCmd);
	}

	if (adcRead)
	{
		adcRead = false;

		// Perform read operation
		value = ADS8688A_ReadRegister(regAddr);
	}

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH2);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[0] = (uint16_t) (msb << 8U);
	isenRaw[0] |= (uint16_t) lsb;
	ADS8688A_Disable();

	SYSTEM_DelayUs(delayUs);

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH3);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	ainRaw[0] = (uint16_t) (msb << 8U);
	ainRaw[0] |= (uint16_t) lsb;
	ADS8688A_Disable();

	SYSTEM_DelayUs(delayUs);

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH4);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	ainRaw[1] = (uint16_t) (msb << 8U);
	ainRaw[1] |= (uint16_t) lsb;
	ADS8688A_Disable();

	SYSTEM_DelayUs(delayUs);

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH5);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[1] = (uint16_t) (msb << 8U);
	isenRaw[1] |= (uint16_t) lsb;
	ADS8688A_Disable();

	SYSTEM_DelayUs(delayUs);

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH7);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[2] = (uint16_t) (msb << 8U);
	isenRaw[2] |= (uint16_t) lsb;
	ADS8688A_Disable();

	SYSTEM_DelayUs(delayUs);

	ADS8688A_Enable();
	ADS8688A_Transfer(ADC_CMD_MAN_CH0);
	ADS8688A_Transfer(ADC_CMD_NOOP);
	msb = ADS8688A_Transfer(ADC_CMD_NOOP);
	lsb = ADS8688A_Transfer(ADC_CMD_NOOP);
	isenRaw[3] = (uint16_t) (msb << 8U);
	isenRaw[3] |= (uint16_t) lsb;
	ADS8688A_Disable();

	DEBUG_TimerStop();
}

