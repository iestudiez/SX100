#ifndef INC_SX100BOARD_H_
#define INC_SX100BOARD_H_

#include <stdbool.h>
#include "system_sx100.h"

// ----------------------------------------------------------------------------
// Defines
// ----------------------------------------------------------------------------
#define PWRBOARD_FREQ_TIMEOUT					(100U)
#define PWR_OFF									(0U)
#define PWR_ON									(1U)

// ----------------------------------------------------------------------------
// Type Definitions
// ----------------------------------------------------------------------------
typedef struct InputDef_t
{
	DinMode_e Mode;
	uint32_t Counter;
	uint32_t Freq;
	uint32_t Rpm;
	bool Value;
	uint16_t Div;
	uint16_t Timeout;
	bool Reset;
} InputDef_t;

typedef struct BoardStatusDef_t
{
	uint16_t VBus;
	uint16_t Current;
	uint16_t Temp;
	uint16_t Power;
	bool Alert;
} BoardStatusDef_t;

typedef struct PwrSupplyDef_t
{
	bool External5Volt;
	bool InternalNpn;
} PwrSupplyDef_t;

typedef struct OutputDef_t
{
	uint16_t DutyCycle;
	uint16_t Current;
} OutputDef_t;

typedef struct AnalogInput_t
{
	uint16_t Value;
	uint8_t Range;
	bool Enable20mA;
} AnalogInput_t;

typedef struct SX100BoardIO_t
{
	InputDef_t Din[4];
	AnalogInput_t Ain[2];
	OutputDef_t Out[4];
	BoardStatusDef_t Status;
	PwrSupplyDef_t PowerSupply;
} SX100BoardIO_t;

// ----------------------------------------------------------------------------
// Public variables
// ----------------------------------------------------------------------------
extern SX100BoardIO_t SX100;

// ----------------------------------------------------------------------------
// Public functions
// ----------------------------------------------------------------------------
void PWRBOARD_Init(void);
void PWRBOARD_Update(void);

#endif /* INC_SX100BOARD_H_ */
